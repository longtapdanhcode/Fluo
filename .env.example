# Copy file này thành .env.local rồi điền giá trị.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Database (Project Settings → Database → Connection string → Transaction pooler) ---
# Chỉ dùng phía server. Không bao giờ để lộ ra client.
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Quản trị: email được vào /admin (cách nhau bằng dấu phẩy) ---
ADMIN_EMAILS=you@example.com

# --- AI (tùy chọn): sinh bài trong CMS + giải thích lỗi sai ---
ANTHROPIC_API_KEY=
# Mặc định claude-opus-5-5. Muốn tiết kiệm cho phần giải thích lỗi (gọi nhiều nhất):
# AI_EXPLAIN_MODEL=claude-haiku-5-5
